generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Trip {
  id                String         @id @default(cuid())
  name              String
  startDate         DateTime       @db.Date
  endDate           DateTime       @db.Date
  takeoffDate       DateTime?      @db.Date
  takeoffTime       String?        @db.VarChar(5)
  landingTime       String?        @db.VarChar(5)
  returnDate        DateTime?      @db.Date
  returnTime        String?        @db.VarChar(5)
  returnLandingTime String?        @db.VarChar(5)
  accommodation     Accommodation?
  days              TripDay[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model Accommodation {
  id        String   @id @default(cuid())
  tripId    String   @unique
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  name      String
  mapUrl    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A few travellers sleep somewhere other than the shared hotel. Their row replaces
// the trip's Accommodation for them alone; everyone without one uses the shared one.
// `person` is a key from lib/people, like the checklist rows.
model PersonStay {
  person    String   @id
  name      String
  mapUrl    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TripDay {
  id         String     @id @default(cuid())
  tripId     String
  trip       Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  date       DateTime   @db.Date
  title      String
  sortOrder  Int
  activities Activity[]

  @@unique([tripId, date])
  @@index([tripId, sortOrder])
}

model Activity {
  id          String   @id @default(cuid())
  tripDayId   String
  tripDay     TripDay  @relation(fields: [tripDayId], references: [id], onDelete: Cascade)
  time        String   @db.VarChar(5)
  name        String
  description String?
  mapUrl      String?
  sortOrder   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tripDayId, sortOrder])
}

// The packing checklist is per person, and "person" is just a key from lib/people —
// the trip has no accounts, only the name picked on the way in, and the rows are
// keyed by that name. PackingProfile records that someone's starter list has
// already been copied in, so emptying the list never makes it grow back.
model PackingProfile {
  person    String   @id
  createdAt DateTime @default(now())
}

model PackingCategory {
  id        String        @id @default(cuid())
  person    String
  name      String
  sortOrder Int
  items     PackingItem[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([person, sortOrder])
}

model PackingItem {
  id         String          @id @default(cuid())
  categoryId String
  category   PackingCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name       String
  checked    Boolean         @default(false)
  sortOrder  Int
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([categoryId, sortOrder])
}

// Group decisions. Anyone may open a poll and everyone votes once, changing their
// mind freely until the poll is closed; a closed poll stays as the record of what the
// group decided. `person` keys come from lib/people, like the checklist rows.
model Poll {
  id        String       @id @default(cuid())
  question  String
  createdBy String
  closedAt  DateTime?
  options   PollOption[]
  votes     PollVote[]
  createdAt DateTime     @default(now())

  @@index([createdAt])
}

model PollOption {
  id        String     @id @default(cuid())
  pollId    String
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  label     String
  sortOrder Int
  votes     PollVote[]

  @@index([pollId, sortOrder])
}

model PollVote {
  pollId    String
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  person    String
  optionId  String
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  updatedAt DateTime   @updatedAt

  @@id([pollId, person])
}

// Shared notes: a title, some text and photos, any of them left out as long as one is
// there. Anyone may write one and everyone reads them; changing or deleting one is for
// whoever wrote it, or the owner. `createdBy` is a key from lib/people, like the poll
// rows.
model Note {
  id        String      @id @default(cuid())
  title     String      @default("")
  body      String
  createdBy String
  images    NoteImage[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([createdAt])
}

// The photo itself lives in the row, shrunk on the phone first (lib/note-images.ts),
// in two sizes: `thumb` for the list and `full` for the viewer. The bytes are heavy,
// so any query that is not serving a picture names the columns it wants.
model NoteImage {
  id        String @id @default(cuid())
  noteId    String
  note      Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)
  full      Bytes
  thumb     Bytes
  sortOrder Int

  @@index([noteId, sortOrder])
}

// What each person has chosen for themselves, whichever phone they use: the order
// of the home page's sections and their colour theme. A row exists only once
// someone changes something; everyone else gets the defaults (lib/home-layout,
// lib/themes).
model Preferences {
  person       String   @id
  homeSections String[] @default([])
  theme        String?
  updatedAt    DateTime @updatedAt
}
