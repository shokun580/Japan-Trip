# Local development (Postgres on your own machine)
DATABASE_URL="postgresql://USER@localhost:5432/japan_trip_dev"

# Production on Neon — copy from the Neon dashboard.
# Use the POOLED host (it contains "-pooler") for the app itself, because serverless
# functions open a lot of short-lived connections.
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# โชกุน's 6-digit PIN, and the key that signs their cookie once it is entered.
# Generate the secret with: openssl rand -base64 32
OWNER_PIN="000000"
SESSION_SECRET="replace-with-a-long-random-string"
